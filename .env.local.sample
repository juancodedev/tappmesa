# ============================================================
# TappMesa — Variables de Entorno para Desarrollo Local
# ============================================================
# Copiar este archivo como .env.local y completar los valores
#
#   cp .env.local.sample .env.local
#
# ⚠️  .env.local contiene credenciales reales — NO se commitea
# ============================================================

# ─── Supabase (OBLIGATORIO) ────────────────────────────────
# URL del proyecto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key — visible en el bundle frontend (Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — SOLO para API routes serverless (NUNCA en frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Base de Datos (opcional, para Prisma migrate/studio) ──
# Connection string directo a PostgreSQL (Pooler mode de Supabase)
# DATABASE_URL=postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres

# ─── Email (opcional en dev, default: solo consola) ────────
# EMAIL_PROVIDER=console    # console (default), resend, sendgrid
# RESEND_API_KEY=re_xxx     # Solo si EMAIL_PROVIDER=resend
# FROM_EMAIL=noreply@tappmesa.com
# FROM_NAME=TappMesa

# ─── Rate Limiting (opcional en dev, default: memoria local) ─
# Vercel KV — solo necesario si quieres rate limiting persistente en dev
# KV_REST_API_URL=https://...  # Vercel KV env var (se agrega automaticamente al deploy)
# KV_REST_API_TOKEN=...
# MAX_CONCURRENT_SESSIONS=5    # Max sesiones por usuario (default: 5)

# ─── URLs (opcional) ────────────────────────────────────────
# FRONTEND_URL=http://localhost:5173   # Para links en emails (reset password)
# VITE_API_BASE_URL=http://localhost:3001  # Override para API en preview deployments

# ─── Seguridad (opcional) ──────────────────────────────────
# BLACKLISTED_IPS=1.2.3.4,5.6.7.8     # IPs bloqueadas
